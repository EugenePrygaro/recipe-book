{
  "name": "recipe-book",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Книга рецептів: статичний фронтенд і серверні функції на Vercel, дані в Upstash Redis, фото у Vercel Blob",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "local": "node scripts/dev.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "dev": "vercel dev",
    "build": "vite build --config vite.config.js",
    "assets": "node scripts/build-assets.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "2.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/onest": "5.3.1",
    "@fontsource-variable/unbounded": "5.3.0",
    "@iconify-json/fluent-emoji-flat": "1.2.6",
    "@iconify-json/lucide": "1.2.147",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6"
  }
}
